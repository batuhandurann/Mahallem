rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The application uses a named Firestore database. Storage Rules can only
    // consult (default), so a stale mirrored ACL is unsafe. App Check enforced
    // callables authorize against the authoritative database for every request.
    // Objects have no firebaseStorageDownloadTokens and are never publicly listed.
    match /{object=**} { allow read, write: if false; }
  }
}
