rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function accountActive(uid) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(uid))
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.deletionStatus != 'REQUESTED'
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.deletionStatus != 'PURGING';
    }

    function safeImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function validGrant(uid, grantId, kind) {
      return firestore.exists(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        ).data.ownerUid == uid
        && firestore.get(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        ).data.kind == kind;
    }

    function validActiveGrant(uid, grantId, kind) {
      return validGrant(uid, grantId, kind)
        && firestore.get(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        ).data.expiresAt > request.time;
    }

    function validChatGrant(uid, conversationId, grantId) {
      return validGrant(uid, grantId, 'CHAT')
        && firestore.get(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        ).data.conversationId == conversationId;
    }

    function validActiveChatGrant(uid, conversationId, grantId) {
      return validActiveGrant(uid, grantId, 'CHAT')
        && firestore.get(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        ).data.conversationId == conversationId;
    }

    function validJobGrant(uid, requestId, grantId) {
      return validGrant(uid, grantId, 'JOB_REQUEST')
        && firestore.get(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        ).data.requestId == requestId;
    }

    function validActiveJobGrant(uid, requestId, grantId) {
      return validActiveGrant(uid, grantId, 'JOB_REQUEST')
        && firestore.get(
          /databases/(default)/documents/users/$(uid)/uploadGrants/$(grantId)
        ).data.requestId == requestId;
    }

    function filenameGrantId(fileName) {
      return fileName.split('\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)[0];
    }

    match /users/{uid}/images/{fileName} {
      allow read: if accountActive(uid)
        && request.auth.uid == uid
        && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)
        && validGrant(uid, filenameGrantId(fileName), 'USER')
        && firestore.get(/databases/(default)/documents/users/$(uid)/uploadGrants/$(filenameGrantId(fileName))).data.validated == true;
      allow write: if accountActive(uid)
        && request.auth.uid == uid
        && resource == null
        && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)
        && validActiveGrant(uid, filenameGrantId(fileName), 'USER')
        && safeImage();
      allow delete: if accountActive(uid)
        && request.auth.uid == uid
        && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
);
    }

    match /jobRequests/{ownerUid}/{requestId}/images/{fileName} {
      allow read: if accountActive(ownerUid)
        && request.auth.uid == ownerUid
        && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)
        && validJobGrant(ownerUid, requestId, filenameGrantId(fileName))
        && firestore.get(/databases/(default)/documents/users/$(ownerUid)/uploadGrants/$(filenameGrantId(fileName))).data.validated == true;
      allow write: if accountActive(ownerUid)
        && request.auth.uid == ownerUid
        && resource == null
        && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)
        && validActiveJobGrant(ownerUid, requestId, filenameGrantId(fileName))
        && firestore.exists(/databases/(default)/documents/jobRequests/$(requestId))
        && firestore.get(/databases/(default)/documents/jobRequests/$(requestId)).data.ownerId == ownerUid
        && safeImage();
      allow delete: if isAdmin()
        || (signedIn()
          && request.auth.uid == ownerUid
          && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)
          && firestore.exists(/databases/(default)/documents/jobRequests/$(requestId))
          && firestore.get(/databases/(default)/documents/jobRequests/$(requestId)).data.ownerId == ownerUid);
    }

    match /chatAttachments/{conversationId}/{senderUid}/{fileName} {
      allow read: if accountActive(request.auth.uid)
        && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds
        && validChatGrant(senderUid, conversationId, filenameGrantId(fileName))
        && firestore.get(/databases/(default)/documents/users/$(senderUid)/uploadGrants/$(filenameGrantId(fileName))).data.validated == true;
      allow write: if accountActive(senderUid)
        && request.auth.uid == senderUid
        && resource == null
        && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
)
        && validActiveChatGrant(senderUid, conversationId, filenameGrantId(fileName))
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantIds
        && safeImage();
      allow delete: if isAdmin()
        || (accountActive(senderUid) && request.auth.uid == senderUid
          && fileName.matches('^[A-Za-z0-9_-]{1,80}\\.jpg

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
));
    }

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
