rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function safeImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && safeImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /jobRequests/{ownerUid}/{requestId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow write: if signedIn() && request.auth.uid == ownerUid && safeImage();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == ownerUid);
    }

    match /providers/{providerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write, delete: if isAdmin();
    }

    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
