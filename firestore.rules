rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function ownsUser(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsProvider() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function ownsRequest() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function verifiedContact() {
      return signedIn()
        && (request.auth.token.phone_number != null || request.auth.token.email_verified == true);
    }
    function boundedString(data, key, max) {
      return !((key in data)) || (data[key] is string && data[key].size() <= max);
    }
    function validServiceArea(data) {
      return !('serviceArea' in data) || (
        data.serviceArea is map
        && data.serviceArea.keys().hasOnly(['latitude','longitude'])
        && (!('latitude' in data.serviceArea) || data.serviceArea.latitude is number)
        && (!('longitude' in data.serviceArea) || data.serviceArea.longitude is number)
      );
    }
    function accountActive() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletionStatus != 'REQUESTED'
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletionStatus != 'PURGING'));
    }

    match /users/{uid} {
      allow read: if ownsUser(uid) || isAdmin();
      allow create: if verifiedContact() && ownsUser(uid) && request.resource.data.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('phoneNumber' in request.resource.data)
          || request.resource.data.phoneNumber == request.auth.token.phone_number)
        && request.resource.data.keys().hasOnly(['uid','displayName','photoUrl','phoneNumber','role','createdAt','updatedAt','district','city','language','notificationPreferences'])
        && boundedString(request.resource.data, 'displayName', 120)
        && boundedString(request.resource.data, 'photoUrl', 500)
        && boundedString(request.resource.data, 'phoneNumber', 32)
        && boundedString(request.resource.data, 'district', 80)
        && boundedString(request.resource.data, 'city', 80)
        && boundedString(request.resource.data, 'language', 16);
      allow update: if isAdmin() || (accountActive() && ownsUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','district','city','language','notificationPreferences','updatedAt'])
        && boundedString(request.resource.data, 'displayName', 120)
        && boundedString(request.resource.data, 'photoUrl', 500)
        && boundedString(request.resource.data, 'district', 80)
        && boundedString(request.resource.data, 'city', 80)
        && boundedString(request.resource.data, 'language', 16));
      allow delete: if isAdmin();
      match /devices/{tokenId} {
        allow read, write: if false;
      }
    }

    match /providers/{providerId} {
      allow get: if isAdmin() || accountActive();
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 50);
      allow create: if verifiedContact() && accountActive() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId','displayName','title','bio','sector','categoryId','district','city','experienceYears','serviceArea','isOpenForOffers','createdAt','updatedAt'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 2000))
        && (!('sector' in request.resource.data) || (request.resource.data.sector is string && request.resource.data.sector.size() <= 64))
        && (!('categoryId' in request.resource.data) || (request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 80))
        && (!('district' in request.resource.data) || (request.resource.data.district is string && request.resource.data.district.size() <= 80))
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 80))
        && validServiceArea(request.resource.data)
        && (!('isOpenForOffers' in request.resource.data) || request.resource.data.isOpenForOffers is bool);
      allow update: if isAdmin() || (accountActive() && ownsProvider()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','title','bio','sector','categoryId','district','city','experienceYears','serviceArea','isOpenForOffers','updatedAt'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 2000))
        && (!('sector' in request.resource.data) || (request.resource.data.sector is string && request.resource.data.sector.size() <= 64))
        && (!('categoryId' in request.resource.data) || (request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 80))
        && (!('district' in request.resource.data) || (request.resource.data.district is string && request.resource.data.district.size() <= 80))
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 80))
        && validServiceArea(request.resource.data)
        && (!('isOpenForOffers' in request.resource.data) || request.resource.data.isOpenForOffers is bool));
      allow delete: if isAdmin();
    }

    match /jobRequests/{requestId} {
      allow get: if isAdmin() || accountActive();
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 50);
      allow create: if verifiedContact() && accountActive() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'PENDING'
        && request.resource.data.keys().hasOnly(['ownerId','title','sector','categoryId','district','urgencyMode','eventOrJobDate','eventTime','budgetEstimate','status','createdAt','updatedAt'])
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
        && (!('sector' in request.resource.data) || (request.resource.data.sector is string && request.resource.data.sector.size() <= 64))
        && (!('categoryId' in request.resource.data) || (request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 80))
        && (!('district' in request.resource.data) || (request.resource.data.district is string && request.resource.data.district.size() <= 80))
        && (!('urgencyMode' in request.resource.data) || (request.resource.data.urgencyMode is string && request.resource.data.urgencyMode.size() <= 32))
        && (!('eventOrJobDate' in request.resource.data) || (request.resource.data.eventOrJobDate is string && request.resource.data.eventOrJobDate.size() <= 32))
        && (!('eventTime' in request.resource.data) || (request.resource.data.eventTime is string && request.resource.data.eventTime.size() <= 32))
        && (!('budgetEstimate' in request.resource.data) || (request.resource.data.budgetEstimate is string && request.resource.data.budgetEstimate.size() <= 200));
      allow update: if isAdmin()
        || (accountActive() && ownsRequest()
          && resource.data.status in ['PENDING', 'QUOTED']
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','sector','categoryId','district','urgencyMode','eventOrJobDate','eventTime','budgetEstimate','updatedAt'])
          && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
          && (!('budgetEstimate' in request.resource.data) || (request.resource.data.budgetEstimate is string && request.resource.data.budgetEstimate.size() <= 200)));
      allow delete: if isAdmin() || (ownsRequest() && resource.data.status == 'PENDING');
    }

    match /jobRequestPrivate/{requestId} {
      allow read: if isAdmin() || (accountActive() && resource.data.ownerId == request.auth.uid);
      allow create: if verifiedContact()
        && accountActive()
        && request.resource.data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/jobRequests/$(requestId))
        && get(/databases/$(database)/documents/jobRequests/$(requestId)).data.ownerId == request.auth.uid
        && (!('phoneVerified' in request.resource.data)
          || request.resource.data.phoneVerified == false
          || request.resource.data.customerPhone == request.auth.token.phone_number)
        && request.resource.data.keys().hasOnly([
          'ownerId','address','customerName','customerPhone','phoneVerified',
          'areaSquareMeters','roomCount','isFurnished','materialsIncluded',
          'renovationNotes','eventType','durationHours','targetAgeGroup',
          'selectedCostumeOrCharacter','extraServicesRequested','latitude',
          'longitude','updatedAt'
        ])
        && boundedString(request.resource.data, 'address', 500)
        && boundedString(request.resource.data, 'customerName', 120)
        && boundedString(request.resource.data, 'customerPhone', 32)
        && boundedString(request.resource.data, 'renovationNotes', 2000)
        && boundedString(request.resource.data, 'eventType', 80)
        && boundedString(request.resource.data, 'targetAgeGroup', 80)
        && boundedString(request.resource.data, 'selectedCostumeOrCharacter', 120)
        && boundedString(request.resource.data, 'extraServicesRequested', 1000);
      allow update: if isAdmin()
        || (accountActive()
          && resource.data.ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/jobRequests/$(requestId))
          && get(/databases/$(database)/documents/jobRequests/$(requestId)).data.ownerId == request.auth.uid
          && (!('phoneVerified' in request.resource.data)
            || request.resource.data.phoneVerified == false
            || request.resource.data.customerPhone == request.auth.token.phone_number)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'address','customerName','customerPhone','phoneVerified',
            'areaSquareMeters','roomCount','isFurnished','materialsIncluded',
            'renovationNotes','eventType','durationHours','targetAgeGroup',
            'selectedCostumeOrCharacter','extraServicesRequested','latitude',
            'longitude','updatedAt'
          ])
          && boundedString(request.resource.data, 'address', 500)
          && boundedString(request.resource.data, 'customerName', 120)
          && boundedString(request.resource.data, 'customerPhone', 32)
          && boundedString(request.resource.data, 'renovationNotes', 2000)
          && boundedString(request.resource.data, 'eventType', 80)
          && boundedString(request.resource.data, 'targetAgeGroup', 80)
          && boundedString(request.resource.data, 'selectedCostumeOrCharacter', 120)
          && boundedString(request.resource.data, 'extraServicesRequested', 1000));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /quotes/{quoteId} {
      allow get: if isAdmin() || (accountActive() && (resource.data.customerId == request.auth.uid || resource.data.providerOwnerId == request.auth.uid));
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 100
        && (resource.data.customerId == request.auth.uid || resource.data.providerOwnerId == request.auth.uid));
      allow create: if false;
      allow update: if isAdmin()
        || (accountActive()
          && resource.data.providerOwnerId == request.auth.uid
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price','durationOrArrival','notes','updatedAt'])
          && request.resource.data.price is string && request.resource.data.price.size() <= 200
          && request.resource.data.durationOrArrival is string && request.resource.data.durationOrArrival.size() <= 200
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000);
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow get: if isAdmin() || (accountActive() && request.auth.uid in resource.data.participantIds);
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 50
        && request.auth.uid in resource.data.participantIds);
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow get: if isAdmin()
        || (accountActive()
          && resource.data.conversationId is string
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds);
      allow list: if isAdmin()
        || (accountActive()
          && request.query.limit <= 200
          && resource.data.conversationId is string
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isAdmin() || (accountActive() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 100
        && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow create, update, delete: if isAdmin();
    }

    match /_admin/{document=**} { allow read, write: if isAdmin(); }
  }
}