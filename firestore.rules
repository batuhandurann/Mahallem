rules_version = '2';

// Private users/{uid} profiles. Required fields:
// uid: string 1..128, immutable, matches Auth UID and document ID.
// displayName: string 2..80. email: string 1..254, matches Auth token.
// createdAt: immutable server timestamp. updatedAt: server timestamp.
// Marketplace access is scoped to authenticated UIDs below.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 1 && data.email.size() <= 254
        && data.email == request.auth.token.email
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && uidUnchanged(userId)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && uidUnchanged(userId) && uidNotModified()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validProvider(d) {
      return d.keys().hasAll(["id", "name", "title", "sector", "categoryId", "rating", "reviewCount", "experienceYears", "district", "city", "hourlyOrBasePrice", "isEmergencyAvailable", "verifiedSafeBadge", "mykCertified", "childSafeCertified", "phoneVerified", "daysRemaining", "isReported", "paintBrandsJson", "charactersOfferedJson", "includedEquipmentsJson", "bookedDatesJson", "isOpenForOffers", "phone", "bio", "beforeAfterJson", "videoShowcasesJson", "isFavorite", "ownerUid", "provinceId", "districtId", "neighborhoodId", "neighborhoodName", "publicGeoHash"])
        && d.keys().hasOnly(["id", "name", "title", "sector", "categoryId", "rating", "reviewCount", "experienceYears", "district", "city", "hourlyOrBasePrice", "isEmergencyAvailable", "verifiedSafeBadge", "mykCertified", "childSafeCertified", "phoneVerified", "daysRemaining", "isReported", "paintBrandsJson", "charactersOfferedJson", "includedEquipmentsJson", "bookedDatesJson", "isOpenForOffers", "phone", "bio", "beforeAfterJson", "videoShowcasesJson", "isFavorite", "ownerUid", "provinceId", "districtId", "neighborhoodId", "neighborhoodName", "publicGeoHash"])
        && d.id is string && d.id.size() <= 5000
        && d.name is string && d.name.size() <= 5000
        && d.title is string && d.title.size() <= 5000
        && d.sector is string && d.sector.size() <= 5000
        && d.categoryId is string && d.categoryId.size() <= 5000
        && d.rating is number && d.rating >= 0
        && d.reviewCount is number && d.reviewCount >= 0
        && d.experienceYears is number && d.experienceYears >= 0
        && d.district is string && d.district.size() <= 5000
        && d.city is string && d.city.size() <= 5000
        && d.hourlyOrBasePrice is string && d.hourlyOrBasePrice.size() <= 5000
        && d.isEmergencyAvailable is bool
        && d.verifiedSafeBadge is bool
        && d.mykCertified is bool
        && d.childSafeCertified is bool
        && d.phoneVerified is bool
        && d.daysRemaining is number && d.daysRemaining >= 0
        && d.isReported is bool
        && d.paintBrandsJson is string && d.paintBrandsJson.size() <= 5000
        && d.charactersOfferedJson is string && d.charactersOfferedJson.size() <= 5000
        && d.includedEquipmentsJson is string && d.includedEquipmentsJson.size() <= 5000
        && d.bookedDatesJson is string && d.bookedDatesJson.size() <= 5000
        && d.isOpenForOffers is bool
        && d.phone is string && d.phone.size() <= 5000
        && d.bio is string && d.bio.size() <= 5000
        && d.beforeAfterJson is string && d.beforeAfterJson.size() <= 5000
        && d.videoShowcasesJson is string && d.videoShowcasesJson.size() <= 5000
        && d.isFavorite is bool
        && d.ownerUid is string && d.ownerUid.size() <= 5000
        && d.provinceId is string && d.provinceId.size() <= 5000
        && d.districtId is string && d.districtId.size() <= 5000
        && d.neighborhoodId is string && d.neighborhoodId.size() <= 5000
        && d.neighborhoodName is string && d.neighborhoodName.size() <= 5000
        && d.publicGeoHash is string && d.publicGeoHash.size() <= 5000
        && d.phone == ""
        && d.phoneVerified == false
        && d.verifiedSafeBadge == false
        && d.mykCertified == false
        && d.childSafeCertified == false
        && d.rating == 0
        && d.reviewCount == 0
        && d.isFavorite == false
        && d.name.size() >= 2
        && d.title.size() >= 2;
    }
    function validRequestDate(value) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      let lastDay = month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31);
      return value.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && year >= 100 && day <= lastDay;
    }
    function validRequest(d) {
      return d.keys().hasAll(["id", "title", "sector", "categoryId", "district", "urgencyMode", "eventOrJobDate", "eventTime", "address", "status", "customerName", "customerPhone", "phoneVerified", "daysRemaining", "isReported", "escrowStatus", "escrowAmount", "areaSquareMeters", "roomCount", "isFurnished", "materialsIncluded", "renovationNotes", "eventType", "durationHours", "targetAgeGroup", "selectedCostumeOrCharacter", "extraServicesRequested", "budgetEstimate", "createdAt", "ownerUid", "provinceId", "districtId", "neighborhoodId", "neighborhoodName", "publicGeoHash"])
        && d.keys().hasOnly(["id", "title", "sector", "categoryId", "district", "urgencyMode", "eventOrJobDate", "eventTime", "address", "status", "customerName", "customerPhone", "phoneVerified", "daysRemaining", "isReported", "escrowStatus", "escrowAmount", "areaSquareMeters", "roomCount", "isFurnished", "materialsIncluded", "renovationNotes", "eventType", "durationHours", "targetAgeGroup", "selectedCostumeOrCharacter", "extraServicesRequested", "budgetEstimate", "createdAt", "ownerUid", "provinceId", "districtId", "neighborhoodId", "neighborhoodName", "publicGeoHash"])
        && d.id is string && d.id.size() <= 5000
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.title.matches('.*[^[:space:]].*')
        && d.sector is string && d.sector.size() <= 5000
        && d.categoryId is string && d.categoryId.size() <= 5000
        && d.district is string && d.district.size() <= 5000
        && d.urgencyMode is string && d.urgencyMode.size() <= 5000
        && d.eventOrJobDate is string && validRequestDate(d.eventOrJobDate)
        && d.eventTime is string && d.eventTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && d.address is string && d.address.size() <= 5000
        && d.status is string && d.status.size() <= 5000
        && d.customerName is string && d.customerName.size() <= 5000
        && d.customerPhone is string && d.customerPhone.size() <= 5000
        && d.phoneVerified is bool
        && d.daysRemaining is number && d.daysRemaining >= 0
        && d.isReported is bool
        && d.escrowStatus is string && d.escrowStatus.size() <= 5000
        && d.escrowAmount is string && d.escrowAmount.size() <= 5000
        && d.areaSquareMeters is number && d.areaSquareMeters >= 0
        && d.roomCount is string && d.roomCount.size() <= 5000
        && d.isFurnished is bool
        && d.materialsIncluded is bool
        && d.renovationNotes is string && d.renovationNotes.size() <= 5000
        && d.eventType is string && d.eventType.size() <= 5000
        && d.durationHours is number && d.durationHours >= 0
        && d.targetAgeGroup is string && d.targetAgeGroup.size() <= 5000
        && d.selectedCostumeOrCharacter is string && d.selectedCostumeOrCharacter.size() <= 5000
        && d.extraServicesRequested is string && d.extraServicesRequested.size() <= 5000
        && d.budgetEstimate is string && d.budgetEstimate.size() <= 5000
        && d.createdAt is number && d.createdAt >= 0
        && d.ownerUid is string && d.ownerUid.size() <= 5000
        && d.provinceId is string && d.provinceId.size() <= 5000
        && d.districtId is string && d.districtId.size() <= 5000
        && d.neighborhoodId is string && d.neighborhoodId.size() <= 5000
        && d.neighborhoodName is string && d.neighborhoodName.size() <= 5000
        && d.publicGeoHash is string && d.publicGeoHash.size() <= 5000
        && d.address == ""
        && d.customerPhone == ""
        && d.phoneVerified == false
        && d.escrowStatus == "NONE"
        && d.escrowAmount == ""
        && d.title.size() >= 2
        && d.status in ["PENDING", "ACCEPTED"];
    }
    function validQuote(d) {
      return d.keys().hasAll(["id", "requestId", "providerId", "providerName", "providerTitle", "providerRating", "price", "durationOrArrival", "notes", "status", "escrowFunded", "receiptCode", "warrantyDuration", "createdAt", "providerUid", "customerUid"])
        && d.keys().hasOnly(["id", "requestId", "providerId", "providerName", "providerTitle", "providerRating", "price", "durationOrArrival", "notes", "status", "escrowFunded", "receiptCode", "warrantyDuration", "createdAt", "providerUid", "customerUid"])
        && d.id is string && d.id.size() <= 5000
        && d.requestId is string && d.requestId.size() <= 5000
        && d.providerId is string && d.providerId.size() <= 5000
        && d.providerName is string && d.providerName.size() <= 5000
        && d.providerTitle is string && d.providerTitle.size() <= 5000
        && d.providerRating is number && d.providerRating >= 0
        && d.price is string && d.price.size() <= 5000
        && d.durationOrArrival is string && d.durationOrArrival.size() <= 5000
        && d.notes is string && d.notes.size() <= 5000
        && d.status is string && d.status.size() <= 5000
        && d.escrowFunded is bool
        && d.receiptCode is string && d.receiptCode.size() <= 5000
        && d.warrantyDuration is string && d.warrantyDuration.size() <= 5000
        && d.createdAt is number && d.createdAt >= 0
        && d.providerUid is string && d.providerUid.size() <= 5000
        && d.customerUid is string && d.customerUid.size() <= 5000
        && d.escrowFunded == false
        && d.receiptCode == ""
        && d.warrantyDuration == ""
        && d.status == "PENDING"
        && d.price.size() > 0;
    }
    function validMessage(d) {
      return d.keys().hasAll(["id", "conversationId", "senderId", "senderName", "text", "timestamp", "isFromMe", "isOfferMessage", "offerPrice", "isVoiceNote", "voiceDurationSeconds", "hasPhotoAttachment", "photoDescription", "photoMediaId"])
        && d.keys().hasOnly(["id", "conversationId", "senderId", "senderName", "text", "timestamp", "isFromMe", "isOfferMessage", "offerPrice", "isVoiceNote", "voiceDurationSeconds", "hasPhotoAttachment", "photoDescription", "photoMediaId"])
        && d.id is string && d.id.size() <= 5000
        && d.conversationId is string && d.conversationId.size() <= 5000
        && d.senderId is string && d.senderId.size() <= 5000
        && d.senderName is string && d.senderName.size() <= 5000
        && d.text is string && d.text.size() <= 4000
        && d.timestamp is number && d.timestamp >= 0
        && d.isFromMe is bool
        && d.isOfferMessage is bool
        && d.offerPrice is string && d.offerPrice.size() <= 5000
        && d.isVoiceNote is bool
        && d.voiceDurationSeconds is number && d.voiceDurationSeconds >= 0
        && d.hasPhotoAttachment is bool
        && d.photoDescription is string && d.photoDescription.size() <= 5000
        && d.photoMediaId is string && d.photoMediaId.size() <= 5000
        && d.text.size() > 0
        && d.isFromMe == false
        && d.isVoiceNote == false
        && d.voiceDurationSeconds == 0
        && d.photoMediaId.size() <= 256;
    }

    function signed() { return request.auth != null; }
    function fresh(d) { return d.createdAt == request.time && d.updatedAt == request.time; }
    function changed(d) { return d.createdAt == resource.data.createdAt && d.updatedAt == request.time; }
    function member(d) { return signed() && request.auth.uid in d.participantUids; }
    function requestDoc(id) { return get(/databases/$(database)/documents/requests/$(id)).data; }
    function requestAfter(id) { return getAfter(/databases/$(database)/documents/requests/$(id)).data; }
    function quoteAfter(id) { return getAfter(/databases/$(database)/documents/quotes/$(id)).data; }
    function notBlocked(a, b) {
      return !exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        && !exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }
    function chatWritable(d) { return member(d) && notBlocked(d.participantUids[0], d.participantUids[1]); }
    function validGeo(d) {
      let names = {'pilot_tr_35_buca_adatepe':'Adatepe','pilot_tr_35_buca_efeler':'Efeler',
        'pilot_tr_35_buca_inonu':'İnönü','pilot_tr_35_buca_sirinkapi':'Şirinkapı','pilot_tr_35_buca_yigitler':'Yiğitler'};
      return d.provinceId == 'tr_35' && d.districtId == 'tr_35_buca'
        && d.neighborhoodId in names && d.neighborhoodName == names[d.neighborhoodId]
        && (d.publicGeoHash == '' || d.publicGeoHash.matches('[0123456789bcdefghjkmnpqrstuvwxyz]{5}'));
    }
    match /users/{userId}/blocks/{blockedUid} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && userId != blockedUid && blockedUid.size() <= 128
        && request.resource.data.keys().hasOnly(['blockedUid','createdAt'])
        && request.resource.data.blockedUid == blockedUid && request.resource.data.createdAt == request.time;
    }
    match /users/{userId}/devices/{deviceId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && deviceId.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096 && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
    }
    function providerDoc(id) { return get(/databases/$(database)/documents/providers/$(id)).data; }

    // One fixed server-time window per UID and operation. The target reference
    // binds every increment to exactly one new document in the same transaction.
    // It prevents both standalone counter churn and sharing an increment across
    // multiple creates in a malicious atomic batch.
    function writeLimit(operation) {
      return {'listing':10, 'quote':60, 'conversation':30, 'message':240, 'report':10}[operation];
    }
    function validWriteBudget(operation, d) {
      return operation in ['listing','quote','conversation','message','report']
        && d.keys().hasAll(['count','windowStartedAt','updatedAt','target'])
        && d.keys().hasOnly(['count','windowStartedAt','updatedAt','target'])
        && d.count is int && d.count >= 1 && d.count <= writeLimit(operation)
        && d.windowStartedAt is timestamp && d.windowStartedAt <= request.time
        && d.updatedAt == request.time && d.target is path;
    }
    function validBudgetTarget(operation, target, userId) {
      let d = getAfter(target).data;
      return !exists(target) && d.createdAt == request.time
        && (
          (operation == 'listing'
            && (target == /databases/$(database)/documents/providers/$(target[4])
              || target == /databases/$(database)/documents/requests/$(target[4]))
            && d.ownerUid == userId)
          || (operation == 'quote'
            && target == /databases/$(database)/documents/quotes/$(target[4])
            && d.providerUid == userId)
          || (operation == 'conversation'
            && target == /databases/$(database)/documents/conversations/$(target[4])
            && userId in d.participantUids)
          || (operation == 'message'
            && target == /databases/$(database)/documents/conversations/$(target[4])/messages/$(target[6])
            && d.senderUid == userId)
          || (operation == 'report'
            && target == /databases/$(database)/documents/reports/$(target[4])
            && d.reporterUid == userId)
        );
    }
    function hasWriteBudget(operation, target) {
      let d = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/writeBudgets/$(operation)).data;
      return validWriteBudget(operation, d) && d.target == target;
    }
    function validConversationPreview(conversationId) {
      let budget = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/writeBudgets/message).data;
      let message = getAfter(budget.target).data;
      return validWriteBudget('message', budget)
        && budget.target == /databases/$(database)/documents/conversations/$(conversationId)/messages/$(message.data.id)
        && !exists(budget.target) && message.createdAt == request.time
        && message.senderUid == request.auth.uid
        && request.resource.data.lastMessage == message.data.text;
    }
    match /users/{userId}/writeBudgets/{operation} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validWriteBudget(operation, request.resource.data)
        && request.resource.data.count == 1
        && request.resource.data.windowStartedAt == request.time
        && validBudgetTarget(operation, request.resource.data.target, userId);
      allow update: if isOwner(userId) && validWriteBudget(operation, request.resource.data)
        && resource.data.windowStartedAt is timestamp && resource.data.windowStartedAt <= request.time
        && resource.data.count is int && resource.data.count >= 1 && resource.data.count <= writeLimit(operation)
        && (
          (request.time < resource.data.windowStartedAt + duration.value(3600, 's')
            && request.resource.data.windowStartedAt == resource.data.windowStartedAt
            && request.resource.data.count == resource.data.count + 1)
          || (request.time >= resource.data.windowStartedAt + duration.value(3600, 's')
            && request.resource.data.windowStartedAt == request.time
            && request.resource.data.count == 1)
        )
        && validBudgetTarget(operation, request.resource.data.target, userId);
      allow delete: if false;
    }

    match /users/{userId}/favorites/{id} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }
    match /providers/{id} {
      allow read: if signed() && (resource.data.ownerUid == request.auth.uid || resource.data.visibility == 'published');
      allow create: if signed() && request.resource.data.keys().hasOnly(['ownerUid','data','createdAt','updatedAt','visibility'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.visibility == 'published' && fresh(request.resource.data)
        && validProvider(request.resource.data.data) && validGeo(request.resource.data.data) && request.resource.data.data.ownerUid == request.auth.uid
        && request.resource.data.data.id == id
        && hasWriteBudget('listing', /databases/$(database)/documents/providers/$(id));
      allow update: if signed() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data','updatedAt'])
        && changed(request.resource.data) && validProvider(request.resource.data.data)
        && request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['isOpenForOffers','bookedDatesJson']);
    }
    match /requests/{id} {
      allow read: if signed() && (resource.data.ownerUid == request.auth.uid
        || resource.data.acceptedProviderUid == request.auth.uid || resource.data.visibility == 'published');
      allow create: if signed() && request.resource.data.keys().hasOnly(['ownerUid','data','createdAt','updatedAt','acceptedQuoteId','acceptedProviderUid','visibility'])
        && fresh(request.resource.data) && request.resource.data.visibility == 'published' && request.resource.data.ownerUid == request.auth.uid
        && validRequest(request.resource.data.data) && validGeo(request.resource.data.data) && request.resource.data.data.id == id
        && request.resource.data.data.ownerUid == request.auth.uid && request.resource.data.data.status == 'PENDING'
        && request.resource.data.acceptedQuoteId == '' && request.resource.data.acceptedProviderUid == ''
        && hasWriteBudget('listing', /databases/$(database)/documents/requests/$(id));
      allow update: if signed() && resource.data.ownerUid == request.auth.uid
        && resource.data.data.status == 'PENDING' && resource.data.acceptedQuoteId == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data','updatedAt','acceptedQuoteId','acceptedProviderUid'])
        && request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(['status'])
        && changed(request.resource.data) && request.resource.data.data.status == 'ACCEPTED'
        && quoteAfter(request.resource.data.acceptedQuoteId).status == 'ACCEPTED'
        && quoteAfter(request.resource.data.acceptedQuoteId).requestId == id
        && quoteAfter(request.resource.data.acceptedQuoteId).customerUid == request.auth.uid
        && quoteAfter(request.resource.data.acceptedQuoteId).providerUid == request.resource.data.acceptedProviderUid;
    }
    match /requestContacts/{id} {
      allow read: if signed() && (resource.data.ownerUid == request.auth.uid
        || requestDoc(id).acceptedProviderUid == request.auth.uid);
      allow create: if signed() && request.resource.data.keys().hasOnly(['ownerUid','phone','address','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid && requestAfter(id).ownerUid == request.auth.uid
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.address is string && request.resource.data.address.size() <= 1000
        && request.resource.data.updatedAt == request.time;
    }
    // State, explanations and history are private and written only by trusted Functions.
    match /jobs/{id} {
      allow read: if signed() && request.auth.uid in resource.data.participantUids;
      allow write: if false;
      match /events/{eventId} {
        allow read: if signed() && request.auth.uid in get(/databases/$(database)/documents/jobs/$(id)).data.participantUids;
        allow write: if false;
      }
    }
    match /providerContacts/{id} {
      allow read: if signed() && resource.data.ownerUid == request.auth.uid;
      allow create: if signed() && request.resource.data.keys().hasOnly(['ownerUid','phone','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/providers/$(id)).data.ownerUid == request.auth.uid
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.updatedAt == request.time;
    }
    match /quotes/{id} {
      allow read: if signed() && (resource.data.customerUid == request.auth.uid || resource.data.providerUid == request.auth.uid);
      allow create: if signed() && request.resource.data.keys().hasOnly(['providerUid','customerUid','requestId','status','data','createdAt','updatedAt'])
        && request.resource.data.providerUid == request.auth.uid && request.resource.data.customerUid != request.auth.uid
        && fresh(request.resource.data) && validQuote(request.resource.data.data)
        && request.resource.data.data.id == id && request.resource.data.data.requestId == request.resource.data.requestId
        && request.resource.data.data.providerUid == request.auth.uid
        && request.resource.data.data.customerUid == request.resource.data.customerUid
        && request.resource.data.status == 'PENDING'
        && requestDoc(request.resource.data.requestId).ownerUid == request.resource.data.customerUid
        && requestDoc(request.resource.data.requestId).data.status == 'PENDING'
        && notBlocked(request.resource.data.providerUid, request.resource.data.customerUid)
        && providerDoc(request.resource.data.data.providerId).ownerUid == request.auth.uid
        && hasWriteBudget('quote', /databases/$(database)/documents/quotes/$(id));
      allow update: if signed() && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && changed(request.resource.data)
        && (
          (resource.data.providerUid == request.auth.uid
            && request.resource.data.status == 'WITHDRAWN'
            && requestDoc(resource.data.requestId).data.status == 'PENDING')
          || (resource.data.customerUid == request.auth.uid
            && (request.resource.data.status == 'REJECTED'
              || (request.resource.data.status == 'ACCEPTED'
                && requestAfter(resource.data.requestId).acceptedQuoteId == id
                && requestAfter(resource.data.requestId).acceptedProviderUid == resource.data.providerUid
                && requestAfter(resource.data.requestId).data.status == 'ACCEPTED')))
        );
    }
    match /conversations/{id} {
      allow get: if signed() && (!exists(/databases/$(database)/documents/conversations/$(id)) || member(resource.data));
      allow list: if member(resource.data);
      allow create: if signed() && request.resource.data.keys().hasOnly(['participantUids','names','relatedItemTitle','lastMessage','createdAt','updatedAt'])
        && request.resource.data.participantUids is list && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] is string && request.resource.data.participantUids[1] is string
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && request.resource.data.participantUids[0].size() <= 128 && request.resource.data.participantUids[1].size() <= 128
        && chatWritable(request.resource.data) && fresh(request.resource.data)
        && request.resource.data.names is map && request.resource.data.names.keys().hasOnly(request.resource.data.participantUids)
        && request.resource.data.names.keys().hasAll(request.resource.data.participantUids)
        && request.resource.data.names[request.resource.data.participantUids[0]] is string
        && request.resource.data.names[request.resource.data.participantUids[1]] is string
        && request.resource.data.names[request.resource.data.participantUids[0]].size() <= 80
        && request.resource.data.names[request.resource.data.participantUids[1]].size() <= 80
        && request.resource.data.relatedItemTitle is string && request.resource.data.relatedItemTitle.size() <= 5000
        && request.resource.data.lastMessage == ''
        && hasWriteBudget('conversation', /databases/$(database)/documents/conversations/$(id));
      allow update: if chatWritable(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt'])
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.updatedAt == request.time
        && validConversationPreview(id);
      match /media/{mediaId} {
        allow read: if member(get(/databases/$(database)/documents/conversations/$(id)).data);
        allow write: if false;
      }
      match /messages/{messageId} {
        allow read: if member(get(/databases/$(database)/documents/conversations/$(id)).data);
        allow create: if chatWritable(get(/databases/$(database)/documents/conversations/$(id)).data)
          && request.resource.data.keys().hasOnly(['senderUid','data','createdAt','updatedAt'])
          && request.resource.data.senderUid == request.auth.uid && fresh(request.resource.data)
          && validMessage(request.resource.data.data) && request.resource.data.data.senderId == request.auth.uid
          && request.resource.data.data.id == messageId && request.resource.data.data.conversationId == id
          && ((!request.resource.data.data.hasPhotoAttachment && request.resource.data.data.photoMediaId == '')
            || (request.resource.data.data.hasPhotoAttachment && request.resource.data.data.photoMediaId != ''
              && get(/databases/$(database)/documents/conversations/$(id)/media/$(request.resource.data.data.photoMediaId)).data.uploaderUid == request.auth.uid))
          && hasWriteBudget('message', /databases/$(database)/documents/conversations/$(id)/messages/$(messageId));
      }
    }
    match /reports/{id} {
      allow read: if signed() && resource.data.reporterUid == request.auth.uid;
      allow create: if signed() && request.resource.data.keys().hasOnly(['reporterUid','targetType','targetId','targetUid','reason','details','status','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.targetType in ['listing','conversation','message','user']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 && request.resource.data.targetId.size() <= 256
        && request.resource.data.targetUid is string && request.resource.data.targetUid.size() > 0 && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in ['fraud','misleading','harassment','spam','unsafe_service','other']
        && request.resource.data.details is string && request.resource.data.details.size() <= 2000
        && request.resource.data.status == 'pending'
        && hasWriteBudget('report', /databases/$(database)/documents/reports/$(id));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
