rules_version = '2';

service cloud.firestore {
  match /databases/\$(database)/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/\$(database)/documents/users/\$(request.auth.uid))
        && get(/databases/\$(database)/documents/users/\$(request.auth.uid)).data.role == "admin";
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update, delete: if isOwner(uid) || isAdmin();
    }
    match /providers/{providerId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /jobRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
    match /quotes/{quoteId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.providerId == request.auth.uid;
      allow update: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /conversations/{conversationId} {
      allow read: if isParticipant() || isAdmin();
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isParticipant() || isAdmin();
      allow delete: if isAdmin();
    }
    match /messages/{messageId} {
      allow read: if isParticipant() || isAdmin();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
