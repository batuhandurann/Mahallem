rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function ownsUser(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsProvider() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function ownsRequest() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function verifiedContact() {
      return signedIn()
        && (request.auth.token.phone_number != null || request.auth.token.email_verified == true);
    }
    function boundedString(data, key, max) {
      return !((key in data)) || (data[key] is string && data[key].size() <= max);
    }
    function validServiceArea(data) {
      return !('serviceArea' in data) || (
        data.serviceArea is map
        && data.serviceArea.keys().hasOnly(['latitude','longitude'])
        && (!('latitude' in data.serviceArea) || data.serviceArea.latitude is number)
        && (!('longitude' in data.serviceArea) || data.serviceArea.longitude is number)
      );
    }
    function accountActive() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletionStatus != 'REQUESTED'
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletionStatus != 'PURGING'));
    }

    match /users/{uid} {
      allow read: if ownsUser(uid) || isAdmin();
      allow create: if verifiedContact() && ownsUser(uid) && request.resource.data.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('phoneNumber' in request.resource.data)
          || request.resource.data.phoneNumber == request.auth.token.phone_number)
        && request.resource.data.keys().hasOnly(['uid','displayName','photoUrl','phoneNumber','role','createdAt','updatedAt','district','city','language','notificationPreferences'])
        && boundedString(request.resource.data, 'displayName', 120)
        && boundedString(request.resource.data, 'photoUrl', 500)
        && boundedString(request.resource.data, 'phoneNumber', 32)
        && boundedString(request.resource.data, 'district', 80)
        && boundedString(request.resource.data, 'city', 80)
        && boundedString(request.resource.data, 'language', 16);
      allow update: if isAdmin() || (accountActive() && ownsUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','district','city','language','notificationPreferences','updatedAt'])
        && boundedString(request.resource.data, 'displayName', 120)
        && boundedString(request.resource.data, 'photoUrl', 500)
        && boundedString(request.resource.data, 'district', 80)
        && boundedString(request.resource.data, 'city', 80)
        && boundedString(request.resource.data, 'language', 16));
      allow delete: if isAdmin();
      match /devices/{tokenId} {
        allow read, write: if false;
      }
    }

    // Public discovery mirrors are written only by trusted backend triggers.
    // Clients may read bounded lists but cannot create or mutate discovery data.
    match /publicProviders/{providerId} {
      allow get: if accountActive();
      allow list: if accountActive() && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    match /publicJobRequests/{requestId} {
      allow get: if accountActive();
      allow list: if accountActive() && request.query.limit <= 50;
      allow create, update, delete: if false;
    }

    match /providers/{providerId} {
      allow get: if isAdmin() || (accountActive() && resource.data.ownerId == request.auth.uid);
      allow list: if false;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /jobRequests/{requestId} {
      allow get: if isAdmin() || (accountActive() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin() || (accountActive()
        && request.query.limit <= 50
        && resource.data.ownerId == request.auth.uid);
      allow create, update: if false;
      allow delete: if isAdmin() || (ownsRequest() && resource.data.status == 'PENDING');
    }

    match /jobRequestPrivate/{requestId} {
      allow read: if isAdmin() || (accountActive() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow get: if isAdmin() || (accountActive() && (resource.data.customerId == request.auth.uid || resource.data.providerOwnerId == request.auth.uid));
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 100
        && (resource.data.customerId == request.auth.uid || resource.data.providerOwnerId == request.auth.uid));
      allow create: if false;
      allow update: if isAdmin()
        || (accountActive()
          && resource.data.providerOwnerId == request.auth.uid
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price','durationOrArrival','notes','updatedAt'])
          && request.resource.data.price is string && request.resource.data.price.size() <= 200
          && request.resource.data.durationOrArrival is string && request.resource.data.durationOrArrival.size() <= 200
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000);
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow get: if isAdmin() || (accountActive() && request.auth.uid in resource.data.participantIds);
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 50
        && request.auth.uid in resource.data.participantIds);
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow get: if isAdmin()
        || (accountActive()
          && resource.data.conversationId is string
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds);
      allow list: if isAdmin()
        || (accountActive()
          && request.query.limit <= 200
          && resource.data.conversationId is string
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isAdmin() || (accountActive() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow list: if isAdmin() || (accountActive() && request.query.limit <= 100
        && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow create, update, delete: if isAdmin();
    }

    match /_admin/{document=**} { allow read, write: if isAdmin(); }
  }
}