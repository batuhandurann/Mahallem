rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function ownsUser(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsProvider() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function ownsRequest() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function verifiedContact() {
      return signedIn()
        && (request.auth.token.phone_number != null || request.auth.token.email_verified == true);
    }
    function accountActive() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletionStatus != 'REQUESTED'
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletionStatus != 'PURGING'));
    }

    match /users/{uid} {
      allow read: if ownsUser(uid) || isAdmin();
      allow create: if verifiedContact() && ownsUser(uid) && request.resource.data.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('phoneNumber' in request.resource.data)
          || request.resource.data.phoneNumber == request.auth.token.phone_number) && request.resource.data.keys().hasOnly(['uid','displayName','photoUrl','phoneNumber','role','createdAt','updatedAt','district','city','language','notificationPreferences']);
      allow update: if isAdmin() || (accountActive() && ownsUser(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','district','city','language','notificationPreferences','updatedAt']));
      allow delete: if isAdmin();
      match /devices/{tokenId} {
        allow read, write: if false;
      }
    }

    match /providers/{providerId} {
      allow read: if isAdmin() || accountActive();
      allow create: if verifiedContact() && accountActive() && request.resource.data.ownerId == request.auth.uid && request.resource.data.keys().hasOnly(['ownerId','displayName','title','bio','sector','categoryId','district','city','experienceYears','serviceArea','isOpenForOffers','createdAt','updatedAt']);
      allow update: if isAdmin() || (accountActive() && ownsProvider() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','title','bio','sector','categoryId','district','city','experienceYears','serviceArea','isOpenForOffers','updatedAt']));
      allow delete: if isAdmin();
    }

    match /jobRequests/{requestId} {
      allow read: if isAdmin() || accountActive();
      allow create: if verifiedContact() && accountActive() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'PENDING' && request.resource.data.keys().hasOnly(['ownerId','title','sector','categoryId','district','urgencyMode','eventOrJobDate','eventTime','budgetEstimate','status','createdAt','updatedAt']);
      allow update: if isAdmin()
        || (accountActive() && ownsRequest()
          && resource.data.status in ['PENDING', 'QUOTED']
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','sector','categoryId','district','urgencyMode','eventOrJobDate','eventTime','budgetEstimate','updatedAt']));
      allow delete: if isAdmin() || (ownsRequest() && resource.data.status == 'PENDING');
    }

    match /jobRequestPrivate/{requestId} {
      allow read: if isAdmin() || (accountActive() && resource.data.ownerId == request.auth.uid);
      allow create: if verifiedContact()
        && accountActive()
        && request.resource.data.ownerId == request.auth.uid
        && exists(/databases/$(database)/documents/jobRequests/$(requestId))
        && get(/databases/$(database)/documents/jobRequests/$(requestId)).data.ownerId == request.auth.uid
        && (!('phoneVerified' in request.resource.data)
          || request.resource.data.phoneVerified == false
          || request.resource.data.customerPhone == request.auth.token.phone_number)
        && request.resource.data.keys().hasOnly([
          'ownerId','address','customerName','customerPhone','phoneVerified',
          'areaSquareMeters','roomCount','isFurnished','materialsIncluded',
          'renovationNotes','eventType','durationHours','targetAgeGroup',
          'selectedCostumeOrCharacter','extraServicesRequested','latitude',
          'longitude','updatedAt'
        ]);
      allow update: if isAdmin()
        || (accountActive()
          && resource.data.ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/jobRequests/$(requestId))
          && get(/databases/$(database)/documents/jobRequests/$(requestId)).data.ownerId == request.auth.uid
          && (!('phoneVerified' in request.resource.data)
            || request.resource.data.phoneVerified == false
            || request.resource.data.customerPhone == request.auth.token.phone_number)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'address','customerName','customerPhone','phoneVerified',
            'areaSquareMeters','roomCount','isFurnished','materialsIncluded',
            'renovationNotes','eventType','durationHours','targetAgeGroup',
            'selectedCostumeOrCharacter','extraServicesRequested','latitude',
            'longitude','updatedAt'
          ]));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /quotes/{quoteId} {
      allow read: if isAdmin() || (accountActive() && (resource.data.customerId == request.auth.uid || resource.data.providerOwnerId == request.auth.uid));
      allow create: if false;
      allow update: if isAdmin()
        || (accountActive()
          && resource.data.providerOwnerId == request.auth.uid
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price','durationOrArrival','notes','updatedAt']));
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (accountActive() && request.auth.uid in resource.data.participantIds);
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin()
        || (accountActive()
          && resource.data.conversationId is string
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (accountActive() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid));
      allow create, update, delete: if isAdmin();
    }

    match /_admin/{document=**} { allow read, write: if isAdmin(); }
  }
}