{
  "name": "burada-security-tests",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-mahallem --only auth,firestore 'node --test test/firebase/*.test.mjs'",
    "test:backend": "npm --prefix functions test && npm --prefix functions run lint",
    "test:media": "firebase emulators:exec --project demo-mahallem --only auth,firestore,storage,functions 'node --test test/media/*.test.mjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
